{
  "name": "dashboard-sales-hubspot",
  "nodes": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "dashboard-sales-hubspot",
      "parameters": {
        "httpMethod": "POST",
        "path": "dashboard-sales-hubspot",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "OpenDeals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "parameters": {
        "method": "GET",
        "url": "https://api.hubapi.com/crm/v3/objects/deals",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "properties", "value": "amount,dealstage,createdate" },
            { "name": "limit", "value": "100" },
            { "name": "archived", "value": "false" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('Webhook').item.json.body.hubspot_token }}" }
          ]
        },
        "options": {
          "response": { "response": { "responseFormat": "json" } }
        }
      }
    },
    {
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "RecentContacts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('Webhook').item.json.body.hubspot_token }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"filterGroups\": [{\n    \"filters\": [{\n      \"propertyName\": \"createdate\",\n      \"operator\": \"GTE\",\n      \"value\": \"{{ Date.now() - 14 * 24 * 60 * 60 * 1000 }}\"\n    }]\n  }],\n  \"properties\": [\"createdate\", \"hs_analytics_source\", \"hs_analytics_source_data_1\"],\n  \"limit\": 100\n}",
        "options": {
          "response": { "response": { "responseFormat": "json" } }
        }
      }
    },
    {
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Aggregate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const dealsItems = $('OpenDeals').first().json.results ?? [];\nconst contactsItems = $('RecentContacts').first().json.results ?? [];\n\nconst closedStages = new Set(['closedwon', 'closedlost']);\nconst pipelineValue = dealsItems\n  .filter(d => !closedStages.has((d.properties.dealstage || '').toLowerCase()))\n  .reduce((s, d) => s + (parseFloat(d.properties.amount) || 0), 0);\n\nconst newLeads = contactsItems.length;\n\nconst autoLeads = contactsItems.filter(c => {\n  const src = (c.properties.hs_analytics_source || '').toUpperCase();\n  return src === 'INTEGRATION' || src === 'API';\n}).length;\n\nconst sparkline = [];\nconst now = Date.now();\nfor (let d = 13; d >= 0; d--) {\n  const dayStart = now - (d + 1) * 86400000;\n  const dayEnd = now - d * 86400000;\n  const dayCount = contactsItems.filter(c => {\n    const t = parseInt(c.properties.createdate, 10);\n    return t >= dayStart && t < dayEnd;\n  }).length;\n  sparkline.push(dayCount);\n}\n\nreturn [{\n  json: {\n    pipeline_value: pipelineValue,\n    new_leads: newLeads,\n    auto_leads: autoLeads,\n    sparkline,\n    period_label: 'Last 14 days'\n  }\n}];\n"
      }
    },
    {
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1240, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [{ "node": "OpenDeals", "type": "main", "index": 0 }]
      ]
    },
    "OpenDeals": {
      "main": [
        [{ "node": "RecentContacts", "type": "main", "index": 0 }]
      ]
    },
    "RecentContacts": {
      "main": [
        [{ "node": "Aggregate", "type": "main", "index": 0 }]
      ]
    },
    "Aggregate": {
      "main": [
        [{ "node": "Respond", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
