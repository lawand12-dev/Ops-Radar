JWT_SECRET=replace-with-32-plus-char-random-string-not-this-default
JWT_EXPIRES_IN_SECONDS=86400

# Encrypts stored Notion OAuth tokens + integration API keys at rest.
# Must decode to exactly 32 bytes when base64-decoded.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CRITICAL: changing this value invalidates every previously stored credential.
INTEGRATIONS_ENCRYPTION_KEY=

# === Supabase (REQUIRED) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === OpenAI (REQUIRED for COO chat + all cron agents) ===
OPENAI_API_KEY=

# === Upstash Redis (REQUIRED — rate limiting + capability cache) ===
# Without this, 6 routes fail hard: COO chat, auth, integrations connect, admin auth.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Cron jobs (REQUIRED — all 41 cron endpoints check this) ===
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match the Authorization header sent by Vercel cron.
CRON_SECRET=

# === Backfill runner (REQUIRED for Notion Brain historical backfill) ===
# Random secret that authorizes internal calls to /api/backfill/run.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKFILL_SECRET=

# === Admin panel ===
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# === Resend (REQUIRED for transactional emails) ===
RESEND_API_KEY=

# === Tavily (optional — web search in COO chat) ===
# Without it, web_search / research_competitor / analyze_document return a graceful error.
# Get your key from: tavily.com
TAVILY_API_KEY=

# === DigitalOcean AI Inference (optional — COO fallback model) ===
# When set, the COO chat falls back to DeepSeek-v4-pro on DigitalOcean
# automatically if OpenAI returns a rate-limit error (TPM exceeded).
# Get your key from: cloud.digitalocean.com → AI/ML → API Keys
# DigitalOcean docs call this variable MODEL_ACCESS_KEY — both names are supported.
DIGITALOCEAN_API_KEY=
MODEL_ACCESS_KEY=
AI_DIGITALOCEAN_URL=https://inference.do-ai.run/v1

# === App URL (REQUIRED — used for OAuth callback URLs) ===
NEXT_PUBLIC_SITE_URL=https://www.opsradar.co
