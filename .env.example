PORT=3000
NODE_ENV=development

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=automation_builder
MYSQL_CONNECT_TIMEOUT_MS=10000
MYSQL_QUERY_TIMEOUT_MS=15000
MYSQL_TRANSACTION_TIMEOUT_MS=30000

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxx

AI_BASE_URL=https://inference.do-ai.run/v1
AI_BACKUP_PROVIDER=digitalocean
AI_API_KEY=


ANTHROPIC_MODEL=anthropic-claude-opus-4.5

AI_MODEL_PRIMARY=anthropic-claude-4.5-sonnet
AI_MODEL_FAST=anthropic-claude-haiku-4.5
AI_MODEL_COMPLEX=anthropic-claude-opus-4.5
AI_WORKFLOW_MODEL=anthropic-claude-4.5-sonnet
AI_WORKFLOW_FALLBACK_MODELS=anthropic-claude-4.5-sonnet,anthropic-claude-haiku-4.5,anthropic-claude-opus-4.5
AI_ANALYSIS_MODEL=anthropic-claude-4.5-sonnet

AI_WORKFLOW_TOTAL_TIMEOUT_MS=60000
AI_REQUEST_TIMEOUT_MS=45000
AI_REQUEST_RETRIES=0
AI_REQUEST_RETRY_DELAY_MS=750
AI_WORKFLOW_KNOWLEDGE_BASE_ENABLED=true
AI_WORKFLOW_KNOWLEDGE_BASE_DIR=knowledge-base
AI_WORKFLOW_KNOWLEDGE_BASE_MAX_CHARS=20000
AI_WORKFLOW_KNOWLEDGE_BASE_FILE_MAX_CHARS=6000
AI_WORKFLOW_KNOWLEDGE_BASE_TOP_K=8
DEBUG_KNOWLEDGE_BASE_CONTENT=false
AI_SYSTEM_PROMPT=You are a senior n8n automation engineer. Return valid JSON only.
LOG_LEVEL=debug
LOG_CHAT_PROGRESS=true
LOG_AI_RAW_RESPONSE=false
LOG_AI_OUTPUT_TEXT=false

N8N_BASE_URL=http://localhost:5678/api/v1
N8N_API_KEY=
N8N_REQUEST_TIMEOUT_MS=15000
CREDENTIAL_PROVISIONING_MODE=manual_only
PROJECTS_VERIFY_N8N_ON_LIST=true

EVENT_INGEST_TOKEN=
ALERT_FAILURE_THRESHOLD=3
MONITORING_ENABLED=true
MONITORING_INTERVAL_SECONDS=300
MONITORING_EXECUTION_LIMIT=20
MONITORING_SNAPSHOT_RETENTION_DAYS=14

# === Auth (REQUIRED — server fails to boot if missing) ===
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-32-plus-char-random-string-not-this-default
JWT_EXPIRES_IN_SECONDS=86400
# Encrypts per-user n8n_api_key + anthropic_api_key at rest. Rotate carefully —
# changing this value invalidates every previously stored credential.
SECRETS_ENCRYPTION_KEY=replace-with-another-32-plus-char-random-string

# === Composio (REQUIRED for Phase 1 — replaces per-tool API key adapters) ===
# Sign up at composio.dev, create a project, copy the API key.
COMPOSIO_API_KEY=

# Webhook secret — Composio signs callbacks with HMAC-SHA256 using this. Set this
# value in BOTH the Composio dashboard webhook config and here. If unset, the
# webhook handler will warn and accept unauthenticated requests (dev only).
COMPOSIO_WEBHOOK_SECRET=

# Per-toolkit Auth Config IDs (created in the Composio dashboard → Auth Configs).
# Convention: COMPOSIO_AUTH_CONFIG_<TOOL_SLUG_UPPERCASE>. Add only the toolkits
# you want to offer customers. Tools without an Auth Config will return a 503
# "auth_config_missing" from /api/composio/connect.
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_HUBSPOT=
COMPOSIO_AUTH_CONFIG_PIPEDRIVE=
COMPOSIO_AUTH_CONFIG_APOLLO=
COMPOSIO_AUTH_CONFIG_CALENDLY=
COMPOSIO_AUTH_CONFIG_CLICKUP=
COMPOSIO_AUTH_CONFIG_ASANA=
COMPOSIO_AUTH_CONFIG_MONDAY=
COMPOSIO_AUTH_CONFIG_HARVEST=
COMPOSIO_AUTH_CONFIG_TOGGL=
COMPOSIO_AUTH_CONFIG_NOTION=
COMPOSIO_AUTH_CONFIG_QUICKBOOKS=
COMPOSIO_AUTH_CONFIG_XERO=
COMPOSIO_AUTH_CONFIG_SLACK=
COMPOSIO_AUTH_CONFIG_GOOGLE_CALENDAR=
COMPOSIO_AUTH_CONFIG_GOOGLE_ANALYTICS=
COMPOSIO_AUTH_CONFIG_GOOGLE_ADS=
COMPOSIO_AUTH_CONFIG_FACEBOOK_ADS=
COMPOSIO_AUTH_CONFIG_LINKEDIN=
COMPOSIO_AUTH_CONFIG_BAMBOO_HR=
COMPOSIO_AUTH_CONFIG_GUSTO=
COMPOSIO_AUTH_CONFIG_DOCUSIGN=
COMPOSIO_AUTH_CONFIG_TYPEFORM=
COMPOSIO_AUTH_CONFIG_INTERCOM=
COMPOSIO_AUTH_CONFIG_ZENDESK=
# Stripe blocked by country — Composio Auth Config may not work for OpsRadar.
# Once Stripe is enabled, customers connect via OAuth like every other tool.

# === Notion OAuth (REQUIRED for Phase 2 — customer-owned Brain) ===
# Create a public integration at notion.so/profile/integrations.
# Capabilities: Read content, Update content, Insert content, Read user info.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=https://opsradar.com/api/notion/callback

# === Inngest (REQUIRED for Phase 4 — durable backfill workflow) ===
# Alternative: Vercel Queues. Pick one and wire the orchestrator accordingly.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
