PORT=3000
NODE_ENV=development

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=automation_builder
MYSQL_CONNECT_TIMEOUT_MS=10000
MYSQL_QUERY_TIMEOUT_MS=15000
MYSQL_TRANSACTION_TIMEOUT_MS=30000

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxx

AI_BASE_URL=https://inference.do-ai.run/v1
AI_BACKUP_PROVIDER=digitalocean
AI_API_KEY=


ANTHROPIC_MODEL=anthropic-claude-opus-4.5

AI_MODEL_PRIMARY=anthropic-claude-4.5-sonnet
AI_MODEL_FAST=anthropic-claude-haiku-4.5
AI_MODEL_COMPLEX=anthropic-claude-opus-4.5
AI_WORKFLOW_MODEL=anthropic-claude-4.5-sonnet
AI_WORKFLOW_FALLBACK_MODELS=anthropic-claude-4.5-sonnet,anthropic-claude-haiku-4.5,anthropic-claude-opus-4.5
AI_ANALYSIS_MODEL=anthropic-claude-4.5-sonnet

AI_WORKFLOW_TOTAL_TIMEOUT_MS=60000
AI_REQUEST_TIMEOUT_MS=45000
AI_REQUEST_RETRIES=0
AI_REQUEST_RETRY_DELAY_MS=750
AI_WORKFLOW_KNOWLEDGE_BASE_ENABLED=true
AI_WORKFLOW_KNOWLEDGE_BASE_DIR=knowledge-base
AI_WORKFLOW_KNOWLEDGE_BASE_MAX_CHARS=20000
AI_WORKFLOW_KNOWLEDGE_BASE_FILE_MAX_CHARS=6000
AI_WORKFLOW_KNOWLEDGE_BASE_TOP_K=8
DEBUG_KNOWLEDGE_BASE_CONTENT=false
AI_SYSTEM_PROMPT=You are a senior n8n automation engineer. Return valid JSON only.
LOG_LEVEL=debug
LOG_CHAT_PROGRESS=true
LOG_AI_RAW_RESPONSE=false
LOG_AI_OUTPUT_TEXT=false

N8N_BASE_URL=http://localhost:5678/api/v1
N8N_API_KEY=
N8N_REQUEST_TIMEOUT_MS=15000
CREDENTIAL_PROVISIONING_MODE=manual_only
PROJECTS_VERIFY_N8N_ON_LIST=true

EVENT_INGEST_TOKEN=
ALERT_FAILURE_THRESHOLD=3
MONITORING_ENABLED=true
MONITORING_INTERVAL_SECONDS=300
MONITORING_EXECUTION_LIMIT=20
MONITORING_SNAPSHOT_RETENTION_DAYS=14

# === Silent-failure detection (HARDENING MODE — keep OFF by default) ===
# Three independent toggles. Turn on incrementally — see rollout strategy
# in the chatv2 PR notes. Existing monitoring is unaffected when all OFF.
SILENT_FAILURE_PIPELINE_ENABLED=false
SCHEDULE_DRIFT_ENABLED=false
TELEMETRY_DEEP_INSPECTION_ENABLED=false
# Backpressure: cycle stops issuing includeData fetches after either limit.
# Per cycle == per MONITORING_INTERVAL_SECONDS.
TELEMETRY_INCLUDE_DATA_BUDGET_PER_CYCLE=200
TELEMETRY_CYCLE_TIME_BUDGET_RATIO=0.7
# Comma-separated workflow_id allowlist: these get deep-inspected on every
# eligible execution regardless of the 4-condition rule. Leave empty in prod.
TELEMETRY_DEEP_INSPECTION_ALLOWLIST=

# === Auth (REQUIRED — server fails to boot if missing) ===
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-32-plus-char-random-string-not-this-default
JWT_EXPIRES_IN_SECONDS=86400
# Encrypts per-user n8n_api_key + anthropic_api_key at rest. Rotate carefully —
# changing this value invalidates every previously stored credential.
SECRETS_ENCRYPTION_KEY=replace-with-another-32-plus-char-random-string


## Bootstrap admin (created on first server start; password is NOT reset on reboot)
ADMIN_EMAIL=Admin@ops.co
ADMIN_PASSWORD=Opstestra1

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# ## Platform RAG agent (single shared resource — only users with
# ## users.can_use_rag_agent = 1 are routed here, everyone else uses Anthropic).
# RAG_AGENT_URL=https://cpiemrh6e3bmrd6vsqx3v2ay.agents.do-ai.run
# RAG_AGENT_API_KEY=b03P45RYbPMGm5wJ9_hgUfr-S9-dxE1f

# Service-to-service API key for the /service/* endpoints (workflows/health,
# analytics). Send as `X-Service-API-Key: <key>` or `Authorization: Bearer <key>`.
# Leave unset to disable the /service/* surface cluster-wide (every call then
# returns 401 SERVICE_AUTH_NOT_CONFIGURED). When set, must be ≥32 chars.
CHATV2_SERVICE_API_KEY=