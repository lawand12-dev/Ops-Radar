JWT_SECRET=replace-with-32-plus-char-random-string-not-this-default
JWT_EXPIRES_IN_SECONDS=86400
# Encrypts stored credentials at rest. Rotate carefully —
# changing this value invalidates every previously stored credential.
SECRETS_ENCRYPTION_KEY=replace-with-another-32-plus-char-random-string

# === Composio (REQUIRED for Phase 1 — replaces per-tool API key adapters) ===
# Sign up at composio.dev, create a project, copy the API key.
COMPOSIO_API_KEY=

# Webhook secret — Composio signs callbacks with HMAC-SHA256 using this. Set this
# value in BOTH the Composio dashboard webhook config and here. If unset, the
# webhook handler will warn and accept unauthenticated requests (dev only).
COMPOSIO_WEBHOOK_SECRET=

# Per-toolkit Auth Config IDs (created in the Composio dashboard → Auth Configs).
# Convention: COMPOSIO_AUTH_CONFIG_<TOOL_SLUG_UPPERCASE>. Add only the toolkits
# you want to offer customers. Tools without an Auth Config will return a 503
# "auth_config_missing" from /api/composio/connect.
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_HUBSPOT=
COMPOSIO_AUTH_CONFIG_PIPEDRIVE=
COMPOSIO_AUTH_CONFIG_APOLLO=
COMPOSIO_AUTH_CONFIG_CALENDLY=
COMPOSIO_AUTH_CONFIG_CLICKUP=
COMPOSIO_AUTH_CONFIG_ASANA=
COMPOSIO_AUTH_CONFIG_MONDAY=
COMPOSIO_AUTH_CONFIG_HARVEST=
COMPOSIO_AUTH_CONFIG_TOGGL=
COMPOSIO_AUTH_CONFIG_NOTION=
COMPOSIO_AUTH_CONFIG_QUICKBOOKS=
COMPOSIO_AUTH_CONFIG_XERO=
COMPOSIO_AUTH_CONFIG_SLACK=
COMPOSIO_AUTH_CONFIG_GOOGLE_CALENDAR=
COMPOSIO_AUTH_CONFIG_GOOGLE_ANALYTICS=
COMPOSIO_AUTH_CONFIG_GOOGLE_ADS=
COMPOSIO_AUTH_CONFIG_FACEBOOK_ADS=
COMPOSIO_AUTH_CONFIG_LINKEDIN=
COMPOSIO_AUTH_CONFIG_BAMBOO_HR=
COMPOSIO_AUTH_CONFIG_GUSTO=
COMPOSIO_AUTH_CONFIG_DOCUSIGN=
COMPOSIO_AUTH_CONFIG_TYPEFORM=
COMPOSIO_AUTH_CONFIG_INTERCOM=
COMPOSIO_AUTH_CONFIG_ZENDESK=
# Stripe blocked by country — Composio Auth Config may not work for OpsRadar.
# Once Stripe is enabled, customers connect via OAuth like every other tool.

# === Backfill runner (REQUIRED for Notion Brain historical backfill) ===
# Random secret that authorizes internal calls to /api/backfill/run.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKFILL_SECRET=

# === DigitalOcean AI Inference (optional — COO fallback model) ===
# When set, the COO chat falls back to DeepSeek-v4-pro on DigitalOcean
# automatically if OpenAI returns a rate-limit error (TPM exceeded).
# Get your API key from: cloud.digitalocean.com → AI/ML → API Keys
DIGITALOCEAN_API_KEY=
AI_DIGITALOCEAN_URL=https://inference.do-ai.run/v1
