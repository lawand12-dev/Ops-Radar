{
  "name": "ops-radar-ai-automation-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/index.ts",
    "dev:bun": "bun --watch src/index.ts",
    "start": "node --env-file=.env --import tsx src/index.ts",
    "start:bun": "bun src/index.ts",
    "migrate": "node --env-file=.env --import tsx src/scripts/migrate.ts",
    "migrate:bun": "bun src/scripts/migrate.ts",
    "migrate-pg": "node --env-file=.env --import tsx src/scripts/migrate-pg.ts",
    "migrate-pg:bun": "bun src/scripts/migrate-pg.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.1",
    "hono": "^4.10.0",
    "mysql2": "^3.15.2",
    "pg": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/pg": "^8.20.0",
    "bun-types": "^1.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
